NEXT_PUBLIC_BACKEND_API_URL=http://localhost:8000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_ACCESS_TOKEN_REFRESH_THRESHOLD_SECONDS=120
# Production: NEXT_PUBLIC_BACKEND_API_URL=https://api.feeders.app
# Production: NEXT_PUBLIC_BETTER_AUTH_URL=https://www.feeders.app

# Must match Backend BETTER_AUTH_SECRET
BETTER_AUTH_SECRET=replace_with_same_secret_used_by_backend
BETTER_AUTH_SESSION_EXPIRY_SECONDS=1209600

GOOGLE_ID=your_google_client_id
GOOGLE_SECRET=your_google_client_secret

RESEND_KEY=re_xxx
RESEND_FROM=noreply@yourdomain.com

