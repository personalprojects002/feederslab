# =============================================================
# Backend environment template
# Copy this file to Backend/.env and fill values.
# =============================================================

# Runtime mode: PROD or TEST
DATABASE=PROD

# Comma-separated allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
FRONTEND_ORIGIN=http://localhost:3000
# Production: CORS_ORIGINS=https://www.feeders.app
# Production: FRONTEND_ORIGIN=https://www.feeders.app

# Database URLs
BACKEND_PROD_DATABASE_URL=postgresql://neondb_owner:npg_lIO4viJFSp7C@ep-super-forest-ahbjzibb-pooler.c-3.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
BACKEND_TEST_DATABASE_URL=postgresql://neondb_owner:npg_lIO4viJFSp7C@ep-super-forest-ahbjzibb-pooler.c-3.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Must match frontend BETTER_AUTH_SECRET
BETTER_AUTH_SECRET=replace_with_a_long_random_secret_min_32_chars

# Stripe
STRIPE_SECRET_KEY=sk_live_or_test_key
STRIPE_PRODUCT_PRICE_ID=price_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Public frontend app URL (used for JWKS lookup and redirect links)
APP_URL=http://localhost:3000
# Production: APP_URL=https://www.feeders.app

# Token lifecycle
ACCESS_TOKEN_EXPIRY_SECONDS=1800
REFRESH_TOKEN_EXPIRY_DAYS=14
REFRESH_TOKEN_LEEWAY_SECONDS=30

# Refresh token cookie
REFRESH_COOKIE_NAME=feeders_refresh_token
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_PATH=/
# Production: REFRESH_COOKIE_SECURE=true

# =============================================================
# Production guidance
# =============================================================
# DATABASE=PROD
# CORS_ORIGINS=https://www.feeders.app
# FRONTEND_ORIGIN=https://www.feeders.app
# APP_URL=https://www.feeders.app
# REFRESH_COOKIE_SECURE=true
# REFRESH_COOKIE_SAMESITE=lax   # use none only for true cross-site cookies
